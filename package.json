{
  "name": "lyrica",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS=\"--max-old-space-size=${NODE_MAX_MEMORY:-8192}\" next dev --turbopack",
    "build": "bash scripts/check-no-dev-server.sh && next build",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "guard:no-dev-server": "bash scripts/check-no-dev-server.sh",
    "dev:kill": "bash scripts/kill-next-dev.sh",
    "dev:reset": "bash scripts/dev-reset.sh",
    "dev:next:webpack": "NODE_OPTIONS=\"--max-old-space-size=${NODE_MAX_MEMORY:-8192}\" next dev --webpack"
  },
  "dependencies": {
    "@remotion/bundler": "^4.0.436",
    "@remotion/cli": "^4.0.436",
    "@remotion/media-utils": "^4.0.436",
    "@remotion/player": "^4.0.436",
    "@remotion/renderer": "^4.0.436",
    "groq-sdk": "^1.1.1",
    "next": "^16.1.7",
    "openai": "^6.32.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "remotion": "^4.0.436",
    "zod": "^4.3.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.28.0",
    "eslint-config-next": "^16.2.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3"
  }
}
