{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "rootDir": ".",
    "noEmitOnError": true
  },
  "include": [
    "tests/**/*.test.ts"
  ]
}
